# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
# The pipeline runs fully without any of these; the AI and research stages
# degrade to their deterministic fallbacks and say so in the UI.
# ---------------------------------------------------------------------------

# --- LLM ---------------------------------------------------------------
# provider: auto | anthropic | openai
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=45
LLM_MAX_RETRIES=3
LLM_BATCH_SIZE=10
LLM_ENABLED=true

# --- Manufacturer research --------------------------------------------
# provider: none | tavily | serper
SEARCH_PROVIDER=none
SEARCH_API_KEY=
RESEARCH_ENABLED=false
RESEARCH_TIMEOUT=20
RESEARCH_MAX_PAGES=3

# --- Pipeline ----------------------------------------------------------
MAX_WORKERS=8
CACHE_ENABLED=true
REVIEW_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Deployment / production
# ---------------------------------------------------------------------------
# Set these in your hosting platform's environment settings, NOT in a committed
# file. See docs/DEPLOYMENT.md.

# Injected by Render / Railway / Fly. Only set it locally if 8000 is taken.
# PORT=8000

# Comma-separated allow-list. Only matters for a SPLIT deploy (SPA on a CDN).
# The default single-service deployment serves the SPA from the same origin and
# needs no cross-origin access at all.
CORS_ORIGINS=*

# Guards for a public demo on a small instance. A 1,000-row run peaks at ~210 MB.
MAX_UPLOAD_MB=10
MAX_ROWS=2000
MAX_RETAINED_JOBS=5
