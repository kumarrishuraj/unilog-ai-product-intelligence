# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
# The pipeline runs fully without any of these; the AI and research stages
# degrade to their deterministic fallbacks and say so in the UI.
# ---------------------------------------------------------------------------

# --- LLM ---------------------------------------------------------------
# provider: auto | anthropic | openai
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=45
LLM_MAX_RETRIES=3
LLM_BATCH_SIZE=10
LLM_ENABLED=true

# --- Manufacturer research --------------------------------------------
# provider: none | tavily | serper
SEARCH_PROVIDER=none
SEARCH_API_KEY=
RESEARCH_ENABLED=false
RESEARCH_TIMEOUT=20
RESEARCH_MAX_PAGES=3

# --- Pipeline ----------------------------------------------------------
MAX_WORKERS=8
CACHE_ENABLED=true
REVIEW_THRESHOLD=0.62
