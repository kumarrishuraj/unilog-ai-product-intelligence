# Only needed for a SPLIT deploy (SPA on a CDN, API elsewhere).
#
# Leave this UNSET for the default single-service deployment: the SPA is served by
# FastAPI from the same origin, so relative /api/... calls already reach the backend.
#
# For a split deploy, set it to the backend's public base URL, with no trailing slash:
# VITE_API_BASE=https://unilog-product-intelligence.onrender.com
VITE_API_BASE=
